+import React from "react";
+import { Link } from "react-router-dom";
+
+function Footer() {
+  return (
+    <footer
+      style={{
+        background: "linear-gradient(to right, #0f172a, #1e293b)",
+        color: "white",
+        marginTop: "50px",
+        padding: "40px 60px",
+      }}
+    >
+      {/* TOP SECTION */}
+      <div
+        style={{
+          display: "flex",
+          justifyContent: "space-between",
+          flexWrap: "wrap",
+          gap: "40px",
+        }}
+      >
+        {/* LEFT */}
+        <div style={{ flex: 1, minWidth: "250px" }}>
+          <h2
+            style={{
+              marginBottom: "15px",
+              color: "#38bdf8",
+            }}
+          >
+            Doctor Booking
+          </h2>
+
+          <p
+            style={{
+              color: "#cbd5e1",
+              lineHeight: "1.8",
+            }}
+          >
+            Book appointments with experienced doctors quickly and
+            easily. Manage appointments, cancellations, and schedules
+            in one place.
+          </p>
+        </div>
+
+        {/* CENTER */}
+        <div style={{ flex: 1, minWidth: "200px" }}>
+          <h3 style={{ marginBottom: "15px" }}>Quick Links</h3>
+
+          <div
+            style={{
+              display: "flex",
+              flexDirection: "column",
+              gap: "10px",
+            }}
+          >
+            <Link
+              to="/"
+              style={linkStyle}
+            >
+              Home
+            </Link>
+
+            <Link
+              to="/appointments"
+              style={linkStyle}
+            >
+              My Appointments
+            </Link>
+
+            <Link
+              to="/add-doctor"
+              style={linkStyle}
+            >
+              Add Doctor
+            </Link>
+          </div>
+        </div>
+
+        {/* RIGHT */}
+        <div style={{ flex: 1, minWidth: "250px" }}>
+          <h3 style={{ marginBottom: "15px" }}>Contact</h3>
+
+          <p style={textStyle}>📍 Kolkata, India</p>
+          <p style={textStyle}>📞 +91 9876543210</p>
+          <p style={textStyle}>✉️ support@doctorbooking.com</p>
+        </div>
+      </div>
+
+      {/* ADD DOCTOR BUTTON HORIZONTAL */}
+      <div
+        style={{
+          marginTop: "35px",
+          display: "flex",
+          justifyContent: "center",
+        }}
+      >
+        <Link
+          to="/add-doctor"
+          style={{
+            background: "#38bdf8",
+            color: "#0f172a",
+            padding: "12px 28px",
+            borderRadius: "30px",
+            textDecoration: "none",
+            fontWeight: "bold",
+            fontSize: "16px",
+            transition: "0.3s",
+            boxShadow: "0 4px 15px rgba(56,189,248,0.4)",
+          }}
+        >
+          + Add Doctor
+        </Link>
+      </div>
+
+      {/* BOTTOM */}
+      <div
+        style={{
+          borderTop: "1px solid #334155",
+          marginTop: "30px",
+          paddingTop: "20px",
+          textAlign: "center",
+          color: "#94a3b8",
+          fontSize: "14px",
+        }}
+      >
+        © 2026 Doctor Booking System. All rights reserved.
+      </div>
+    </footer>
+  );
+}
+
+const linkStyle = {
+  color: "#e2e8f0",
+  textDecoration: "none",
+  fontSize: "15px",
+};
+
+const textStyle = {
+  color: "#cbd5e1",
+  marginBottom: "10px",
+};
+
+export default Footer;
